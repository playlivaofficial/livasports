# Put only the token here, never a URL. Do not commit .env.
SPORTMONKS_API_KEY=replace_with_real_token
ODDSPAPI_API_KEY=replace_with_real_token

# Optional validation controls
VALIDATION_DAYS_AHEAD=90
VALIDATION_MIN_FIXTURES=20
VALIDATION_MAX_FIXTURES=60
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3
ODDSPAPI_BASE_URL=https://api.oddspapi.io/v4
ODDSPAPI_VALIDATION_REQUEST_BUDGET=14
ODDSPAPI_MAX_FOOTBALL_FIXTURES=20
ODDSPAPI_MAX_BASKETBALL_FIXTURES=3

# M1 server runtime (placeholders only)
DATABASE_URL=postgresql://user:password@localhost:5432/livasports
ODDS_STALE_AFTER_SECONDS=300
ODDSPAPI_MONTHLY_REQUEST_LIMIT=5000
ODDSPAPI_MIN_REFRESH_SECONDS=300

# M5.1 server-only scheduler boundary (generate the secret directly in the host secret store).
# Keep false until an approved persistent scheduler is configured and observed.
CRON_SECRET=
ODDS_AUTOMATION_ENABLED=false
# Affiliate destinations are absent by default. Never populate a fake tracking URL.
