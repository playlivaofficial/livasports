{
  "name": "livasports",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LivaSports foundation with isolated M0/M0.5 provider validation tooling.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "validate": "node src/cli.js",
    "diagnose:oddspapi": "node src/oddspapi-cli.js --diagnostic",
    "validate:oddspapi": "node src/oddspapi-cli.js",
    "db:migrate": "tsx --env-file=.env.production.local --env-file=.env src/ingestion/cli.ts migrate",
    "sync:football": "tsx --env-file=.env.production.local --env-file=.env src/ingestion/cli.ts football",
    "sync:fixtures": "tsx --env-file=.env.production.local --env-file=.env src/ingestion/cli.ts fixtures",
    "sync:scores": "tsx --env-file=.env.production.local --env-file=.env src/ingestion/cli.ts scores",
    "coverage:competitions": "tsx --env-file=.env src/ingestion/cli.ts coverage",
    "sync:expansion": "tsx --env-file=.env.production.local --env-file=.env src/ingestion/cli.ts expand",
    "db:stats": "tsx --env-file=.env.production.local --env-file=.env src/ingestion/cli.ts stats",
    "db:checkpoint": "tsx --env-file=.env.production.local --env-file=.env scripts/m3-6-checkpoint-db.ts",
    "db:verify": "tsx --env-file=.env.production.local --env-file=.env src/ingestion/cli.ts read",
    "cache:warm": "tsx src/cache/warmup-cli.ts",
    "test:validation": "node --test test/*.test.js",
    "test:m1": "vitest run",
    "test": "node --test test/*.test.js && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "latest",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.5",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "latest"
  }
}
